             _Measures  (measures-only table)

   HOW TO USE
   - Measures  : create them in the _Measures table (Modeling > New measure).
   - Columns   : create them in the mymoviedb table (Table tools > New column).
   - "Expected" comments show what the dashboard displays for each item.

   NOTE ON ACCURACY
   The measure / column NAMES and the data they feed come straight from the
   Power BI report (Movie_analytics.pbix). The formula bodies below are written to
   reproduce the values shown on the dashboard (the category and tier cut-offs
   were checked against the dashboard counts). If you want them to be
   character-for-character identical to your model, compare with the TMDL view
   in Power BI Desktop and paste your own version over any that differ.
   ============================================================================= */


/* ============================================================================
   1. KPI MEASURES  (table: _Measures)
   ============================================================================ */

-- Expected: 9,817
Total Movies =
COUNTROWS ( mymoviedb )

-- Expected: 13.7M
Total Votes =
SUM ( mymoviedb[Vote_Count] )

-- Expected: 6.4  (card, format 0.0)
Average Rating =
AVERAGE ( mymoviedb[Vote_Average] )

-- Expected: 6.44  (gauge, format 0.00)
Average Movie Rating =
AVERAGE ( mymoviedb[Vote_Average] )

-- Expected: 5.1K  (5,083.954)
Top Popularity =
MAX ( mymoviedb[Popularity] )

-- Title of the most popular movie in the current filter (used on the monthly popularity chart)
-- Expected (no filters): Spider-Man: No Way Home
Highest Popular Movie =
VAR _TopMovie =
    TOPN (
        1,
        VALUES ( mymoviedb[Title] ),
        CALCULATE ( MAX ( mymoviedb[Popularity] ) ),
        DESC
    )
RETURN
    MAXX ( _TopMovie, mymoviedb[Title] )


/* ============================================================================
   2. GAUGE MEASURES  (table: _Measures)
   ============================================================================ */

Gauge Minimum = 0

Gauge Maximum = 10

-- Target line shown at 8 on the gauge
Gauge Target = 8

Gauge Title = "Rating - Average"


/* ============================================================================
   3. RATING STATUS MEASURES  (table: _Measures)
   Text label + colour for the current average rating.
   ============================================================================ */

-- Expected (no filters, 6.44): Average
Rating Status =
VAR _Rating = [Average Movie Rating]
RETURN
    SWITCH (
        TRUE (),
        _Rating >= 8, "Excellent",
        _Rating >= 7, "Good",
        _Rating >= 6, "Average",
        _Rating >= 5, "Below Average",
        "Poor"
    )

Rating Status Color =
VAR _Rating = [Average Movie Rating]
RETURN
    SWITCH (
        TRUE (),
        _Rating >= 8, "#2E7D32",
        _Rating >= 7, "#9CCC65",
        _Rating >= 6, "#FFB300",
        _Rating >= 5, "#FB8C00",
        "#C62828"
    )


/* ============================================================================
   4. CALCULATED COLUMNS  (table: mymoviedb)
   ============================================================================ */

-- e.g. 2021 -> "2020s"
Release Decade =
( mymoviedb[Release Year] - MOD ( mymoviedb[Release Year], 10 ) ) & "s"

-- Movies with 0 votes are "Not Rated"; the rest are bucketed by Vote_Average.
-- Dashboard split: Poor 5.01% | Below Average 20.11% | Average 41.06%
--                  Good 28.38% | Excellent 4.42% | Not Rated (about 1%)
Rating_Category =
IF (
    mymoviedb[Vote_Count] = 0,
    "Not Rated",
    SWITCH (
        TRUE (),
        mymoviedb[Vote_Average] >= 8, "Excellent",
        mymoviedb[Vote_Average] >= 7, "Good",
        mymoviedb[Vote_Average] >= 6, "Average",
        mymoviedb[Vote_Average] >= 5, "Below Average",
        "Poor"
    )
)

-- Sort-by-column helper so categories appear Poor -> Excellent, Not Rated last
Rating_Category_Order =
SWITCH (
    mymoviedb[Rating_Category],
    "Poor", 1,
    "Below Average", 2,
    "Average", 3,
    "Good", 4,
    "Excellent", 5,
    6
)

-- Dashboard split: Low 7,777 | Moderate 1,491 | High 457 | Very High 92
Popularity_Tier =
SWITCH (
    TRUE (),
    mymoviedb[Popularity] >= 300, "Very High",
    mymoviedb[Popularity] >= 100, "High",
    mymoviedb[Popularity] >= 40, "Moderate",
    "Low"
)

-- Sort-by-column helper so tiers appear Low -> Very High
Popularity_Tier_Order =
SWITCH (
    mymoviedb[Popularity_Tier],
    "Low", 1,
    "Moderate", 2,
    "High", 3,
    "Very High", 4
)

